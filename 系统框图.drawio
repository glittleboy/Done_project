        <UserObject label="&lt;font style=&quot;font-size: 25px;&quot;&gt;S3 Bucket&lt;br&gt;│&lt;br&gt;├── smartflow/                              # 平台全局（只读）&lt;br&gt;│   ├── config/                             # 平台级系统配置（S3 API 读取，不挂载进沙箱）&lt;br&gt;│   │   └── sandbox_spec.json&lt;br&gt;│   ├── shared/                             # 挂载到 /sf_smartflow（ro）&lt;br&gt;│   │   ├── templates/                      # Agent 提示词骨架模板&lt;br&gt;│   │   └── skills/                         # 平台级 Skill 定义&lt;br&gt;│   └── agents/                             # 平台级 Agent（如 Pangu）&lt;br&gt;│       └── pangu/&lt;br&gt;│           └── agent/&lt;br&gt;│               ├── agent.json&lt;br&gt;│               ├── prompts/&lt;br&gt;│               └── setup/&lt;br&gt;│                   └── init.sh&lt;br&gt;│&lt;br&gt;└── workspaces/                             # 所有业务空间&lt;br&gt;    └── {biz_id}/&lt;br&gt;        ├── sf_config/                      # 业务级系统配置&lt;br&gt;        │   ├── sandbox_spec.json&lt;br&gt;        │   └── permissions.json&lt;br&gt;        ├── sf_sandbox_presets/             # 可选沙箱预设方案（消息级动态指定）&lt;br&gt;        │   └── {config_name}.json&lt;br&gt;        ├── agents/                         # 该业务下所有 Agent&lt;br&gt;        │   └── {agent_id}/&lt;br&gt;        │       ├── sf_config/              # Agent 级系统配置&lt;br&gt;        │       │   ├── sandbox_spec.json&lt;br&gt;        │       │   └── permissions.json&lt;br&gt;        │       └── agent/                  # Agent 运行数据（挂载到 /sf_agent，rw）&lt;br&gt;        │           ├── agent.json          # Agent 运行配置（必须存在）&lt;br&gt;        │           ├── prompts/            # 系统提示词（*.md）&lt;br&gt;        │           ├── memory/             # Agent 级共享 Memory&lt;br&gt;        │           └── setup/&lt;br&gt;        │               └── init.sh         # 初始化脚本&lt;br&gt;        └── users/&lt;br&gt;            └── {mis_id}/                   # 挂载到 /home/user（rw）&lt;br&gt;                ├── workspace/&lt;br&gt;                └── memory/&lt;/f